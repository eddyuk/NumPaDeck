<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Product>NumPaDeck</Product>
    <Company>eddyuk</Company>
    <AssemblyTitle>NumPaDeck</AssemblyTitle>
    <Description>Zero-dependency Windows numpad remapper — map numpad keys to key combos, typed text, media controls, or app/URL launchers.</Description>
    <Copyright>&#169; eddyuk</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/eddyuk/NumPaDeck</RepositoryUrl>
  </PropertyGroup>

</Project>